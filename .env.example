# Database
DATABASE_URL="file:./dev.db"

# Google Analytics 4
# Create a Service Account in Google Cloud Console
# Download the JSON key and paste the values below
GA4_CLIENT_EMAIL="your-service-account@project.iam.gserviceaccount.com"
GA4_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Google PageSpeed Insights
# Get free key at: https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY="your_pagespeed_api_key"

# SEMrush
# Get API key at: https://www.semrush.com/api-analytics/
SEMRUSH_API_KEY="your_semrush_api_key"

# ClickUp
# Get token at: https://app.clickup.com/settings/apps
CLICKUP_API_TOKEN="your_clickup_api_token"

# Sprout Social (requires the Advanced plan + API Permissions entitlement)
# Generate a token: your name -> Account and settings -> API -> Generate API Token
# Find your customer ID: curl https://api.sproutsocial.com/v1/metadata/client -H "Authorization: Bearer YOUR_API_TOKEN"
SPROUT_API_TOKEN="your_sprout_api_token"
SPROUT_CUSTOMER_ID="your_sprout_customer_id"

# Anthropic (for AI summary)
ANTHROPIC_API_KEY="your_anthropic_api_key"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
